# ==============================================================
# SUPABASE CONFIGURATION (Netlify / Vercel / Local)
# ==============================================================
# En Netlify ve a: Site configuration > Environment variables
# Puedes usar cualquiera de estas dos nomenclaturas (ambas son soportadas):
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# O también sin el prefijo VITE_:
# SUPABASE_URL="https://tu-proyecto.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==============================================================
# GEMINI & PLATFORM CONFIGURATION
# ==============================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
